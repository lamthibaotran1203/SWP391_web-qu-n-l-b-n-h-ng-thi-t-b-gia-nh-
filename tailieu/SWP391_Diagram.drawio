        <UserObject label="&lt;span&gt;&lt;b&gt;STAFF&lt;/b&gt;&lt;/span&gt;" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Customer Use Case Diagram" id="rMIbhrMEplQ1qLSuvdvz-227">
          <mxCell parent="rMIbhrMEplQ1qLSuvdvz-189" style="text;html=1;fillColor=none;strokeColor=none;fontSize=34;fontStyle=0;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="24" width="216" x="2299.25" y="1530" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Admin Use Case Diagram\n\nleft to right direction\n\n&#39; =========================================================\n&#39; VISUAL STYLE - Draw.io-like / UML scannable\n&#39; =========================================================\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam linetype ortho\nskinparam ArrowColor #333333\nskinparam ArrowThickness 1\n\nskinparam actor {\n    BackgroundColor white\n    BorderColor #333333\n    FontColor #222222\n    FontSize 13\n    FontStyle bold\n}\n\nskinparam usecase {\n    BackgroundColor white\n    BorderColor #333333\n    FontColor #222222\n    FontSize 11\n}\n\nskinparam rectangle {\n    BackgroundColor #FAFAFA\n    BorderColor #333333\n    FontColor #222222\n    FontSize 15\n    FontStyle bold\n}\n\nskinparam stereotype {\n    FontColor #555555\n    FontSize 10\n}\n\n&#39; =========================================================\n&#39; PRIMARY ACTOR\n&#39; =========================================================\n\nactor \&quot;Admin\&quot; as Admin\n\n&#39; =========================================================\n&#39; SECONDARY / SUPPORTING ACTORS\n&#39; =========================================================\n\nactor \&quot;Email Service\\n(SMTP / Nodemailer)\&quot; as EmailService\n\nactor \&quot;Payment Gateway\&quot; as PaymentGateway\n\n&#39; =========================================================\n&#39; SYSTEM BOUNDARY\n&#39; =========================================================\n\nrectangle \&quot;HomeMart\&quot; {\n\n    &#39; -----------------------------------------------------\n    &#39; LEFT COLUMN - ADMIN USE CASES\n    &#39; -----------------------------------------------------\n\n    usecase \&quot;&lt;b&gt;UC-07&lt;/b&gt;\\nManage Staff &amp; Admin Accounts\&quot; as UC07\n\n    usecase \&quot;&lt;b&gt;UC-11&lt;/b&gt;\\nManage Product Classification Data\&quot; as UC11\n\n    usecase \&quot;&lt;b&gt;UC-12&lt;/b&gt;\\nManage Brands\&quot; as UC12\n\n    usecase \&quot;&lt;b&gt;UC-13&lt;/b&gt;\\nManage Product Catalogue and SKUs\&quot; as UC13\n\n    usecase \&quot;&lt;b&gt;UC-23&lt;/b&gt;\\nCancel Order by Store\&quot; as UC23\n\n    usecase \&quot;&lt;b&gt;UC-25&lt;/b&gt;\\nAdjust Stock\&quot; as UC25\n\n    usecase \&quot;&lt;b&gt;UC-26&lt;/b&gt;\\nView Stock Movement History\&quot; as UC26\n\n    usecase \&quot;&lt;b&gt;UC-27&lt;/b&gt;\\nManage Suppliers\&quot; as UC27\n\n    usecase \&quot;&lt;b&gt;UC-28&lt;/b&gt;\\nCreate Purchase Order\&quot; as UC28\n\n    usecase \&quot;&lt;b&gt;UC-33&lt;/b&gt;\\nRecord Refund Completion\&quot; as UC33\n\n    usecase \&quot;&lt;b&gt;UC-34&lt;/b&gt;\\nView Financial and Sales Reports\&quot; as UC34\n\n    usecase \&quot;&lt;b&gt;UC-35&lt;/b&gt;\\nView Inventory Roll-Forward Report\&quot; as UC35\n\n\n    &#39; -----------------------------------------------------\n    &#39; RIGHT SIDE - LOGIN\n    &#39; -----------------------------------------------------\n\n    usecase \&quot;&lt;b&gt;UC-02&lt;/b&gt;\\nLogin\&quot; as UC02\n}\n\n&#39; =========================================================\n&#39; ADMIN ASSOCIATIONS\n&#39; =========================================================\n\nAdmin -- UC07\nAdmin -- UC11\nAdmin -- UC12\nAdmin -- UC13\nAdmin -- UC23\nAdmin -- UC25\nAdmin -- UC26\nAdmin -- UC27\nAdmin -- UC28\nAdmin -- UC33\nAdmin -- UC34\nAdmin -- UC35\n\n&#39; =========================================================\n&#39; INCLUDE RELATIONSHIPS\n&#39; All authenticated admin use cases include Login\n&#39; =========================================================\n\nUC07 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC11 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC13 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC23 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC25 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC26 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC27 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC28 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC33 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC34 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC35 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\n\n&#39; =========================================================\n&#39; SECONDARY ACTOR ASSOCIATIONS\n&#39; =========================================================\n\nUC07 -- EmailService : staff account credentials\n\nUC23 -- PaymentGateway : refund request\n\nUC33 -- PaymentGateway : refund settlement\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0RMmWKxboA7h2zmtIu0N-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
