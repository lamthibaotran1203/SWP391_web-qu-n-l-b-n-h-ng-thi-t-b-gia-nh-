        <UserObject label="UC-11&lt;br&gt;Manage Product Classification Data" plantUmlId="uc_2" plantUmlBaseStyle="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#333333;whiteSpace=wrap;fontColor=#222222;fontSize=11;shadow=0;" plantUmlBaseValue="UC-11&lt;br&gt;Manage Product Classification Data" id="0RMmWKxboA7h2zmtIu0N-4">
