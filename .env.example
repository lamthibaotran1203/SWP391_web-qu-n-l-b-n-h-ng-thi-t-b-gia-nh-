# Application and database
# Leave these blank for local Docker development; `npm run backend:dev` uses the
# defaults documented in README.md. Fill them only when running against Supabase/deployment.
SPRING_PROFILES_ACTIVE=
DB_URL=
DB_USERNAME=
DB_PASSWORD=
SESSION_COOKIE_SECURE=
# Reserved for the future deployed public URL (email links/payment callbacks). It is not
# consumed by the walking skeleton yet, so keep it blank until a deployment host is chosen.
APP_BASE_URL=

# SMTP (STARTTLS on port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Gia Dụng Việt"

# Server-owned business configuration
APP_DELIVERY_FEE_VND=
APP_PAYMENT_EXPIRY_MINUTES=
SERVER_SERVLET_SESSION_TIMEOUT=
APP_STORE_NAME=
APP_STORE_ADDRESS=
APP_STORE_PHONE=

# First Manager bootstrap; never commit real values
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_MANAGER_FULL_NAME=
